ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_HOST=http://localhost:11434
CLOUD_MODEL=claude-sonnet-4-6
ROUTER_THRESHOLD=3

# ElevenLabs (Sprachausgabe)
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=<deine Voice-ID aus elevenlabs.io>
ELEVENLABS_MODEL=eleven_multilingual_v2

# faster-whisper (Spracheingabe)
WHISPER_MODEL=base
WHISPER_LANGUAGE=de

# Telegram (optional)
TELEGRAM_BOT_TOKEN=

# WhatsApp / Twilio (optional)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886
# Komma-getrennte E.164-Nummern die Zugriff haben (leer = alle erlaubt)
WHATSAPP_AUTHORIZED_NUMBERS=+49123456789,+49987654321

# Webhook-Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Nachrichten pro Minute pro Nummer
WHATSAPP_RATE_LIMIT=20
